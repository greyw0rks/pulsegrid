{
  "name": "pulsegrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Portaldot RPC monitoring with verifiable incident and recovery evidence",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "worker": "tsx worker/main.ts",
    "worker:once": "tsx worker/main.ts --once",
    "db:setup": "tsx scripts/setup-db.ts",
    "prove:network": "tsx scripts/prove-network.ts",
    "wallet:prepare": "tsx scripts/prepare-wallet.ts",
    "wallet:fund": "tsx scripts/fund-reporter.ts",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "test:contracts": "node scripts/run-foundry.mjs forge test --root contracts",
    "test:e2e": "tsx scripts/e2e.ts",
    "prove:drill": "tsx scripts/testnet-drill.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:up": "tsx scripts/local-up.ts",
    "local:stop": "tsx scripts/local-stop.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@polkadot/api": "17.0.2",
    "@polkadot/util-crypto": "^14.0.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "three": "^0.180.0",
    "viem": "^2.38.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
