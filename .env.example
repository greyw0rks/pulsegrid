PULSEGRID_NETWORK=testnet
PULSEGRID_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
PULSEGRID_NATIVE_RPC=wss://test-node-v3.portaldot.dev
PULSEGRID_NATIVE_GENESIS=
PULSEGRID_REGISTRY_ADDRESS=
PULSEGRID_DEPLOYMENT_BLOCK=
PULSEGRID_PRIVATE_KEY=
PULSEGRID_KEY_FILE=.local/testnet-wallet.json
PULSEGRID_OPERATOR_TOKEN=
